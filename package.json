{
  "name": "vegan-challenge",
  "version": "1.0.0",
  "description": "webpage for the vegan challenge campaign",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check": "npx @biomejs/biome format ./src",
    "format": "npx @biomejs/biome format --write ./src",
    "postbuild": "sh -c 'cp -a dist/src/pages/. dist/ && rm -rf dist/src' && sed -i 's|/src/pages||g' dist/sitemap.xml"
  },
  "author": "ezinber",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "esbuild-minify-templates": "^0.13.1",
    "glob": "^13.0.0",
    "html-minifier-terser": "^7.2.0",
    "vite": "^7.3.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "dependencies": {
    "@formbricks/js": "^4.1.0",
    "node": "^24.12.0"
  }
}
